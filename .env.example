# Frontend dev origin allowed by API CORS
# Comma-separated list supported, example: http://localhost:8080,https://your-app.example.com
FRONTEND_ORIGIN=http://localhost:8080

# API server port
API_PORT=8787

# Max JSON payload size accepted by API
API_BODY_LIMIT=100kb

# Rate limits
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SYNC_WINDOW_MS=60000
RATE_LIMIT_SYNC_MAX=30
RATE_LIMIT_PRIVACY_WINDOW_MS=3600000
RATE_LIMIT_PRIVACY_MAX=8

# Required for secure session signing in production
SESSION_SECRET=replace-with-long-random-secret

# Owner-only access credentials
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me

# Supabase project credentials
SUPABASE_URL=https://vfxhjdehbsovlxfvlrun.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
